{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-sonnet-5",
  "enableAllProjectMcpServers": true,
  "pluginConfigs": {
    "google-drive@anthropic-tools": {
      "mcpServers": {
        "google-drive": {
          "google_drive_folder": "Legal Contracts"
        }
      }
    },
    "slack@anthropic-tools": {
      "mcpServers": {
        "slack": {
          "default_channel": "#legal-contracts"
        }
      }
    }
  },
  "permissions": {
    "allow": [
      "Read(src/**)",
      "Write(src/**)",
      "Edit(src/**)",
      "Read(tests/**)",
      "Write(tests/**)",
      "Edit(tests/**)",
      "Read(config/**)",
      "Read(drafting/**)",
      "Bash(npm run test *)",
      "Bash(npm run lint)"
    ]
  },
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "70000",
    "CONTRACTIQ_SLACK_CHANNEL": "#legal-contracts",
    "CONTRACTIQ_PRIMARY_NOTIFICATION_CHANNEL": "slack"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/pre_redline.sh" },
          { "type": "command", "command": "bash .claude/hooks/validate_input.sh" }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/freshness_check.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/post_redline.sh" }
        ]
      }
    ]
  }
}
