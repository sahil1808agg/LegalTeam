{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-sonnet-5",
  "permissions": {
    "allow": [
      "Read(src/**)",
      "Write(src/**)",
      "Edit(src/**)",
      "Read(tests/**)",
      "Write(tests/**)",
      "Edit(tests/**)",
      "Read(config/**)",
      "Read(drafting/**)",
      "Bash(npm run test *)",
      "Bash(npm run lint)"
    ]
  },
  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "70000"
  }
}
