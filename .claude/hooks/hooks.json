{
  "PreToolUse": [
    {
      "matcher": "*",
      "hooks": [
        { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/.claude/hooks/audit_log.sh" }
      ]
    },
    {
      "matcher": "Bash",
      "hooks": [
        { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/.claude/hooks/pre_redline.sh" },
        { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/.claude/hooks/validate_input.sh" }
      ]
    },
    {
      "matcher": "Read",
      "hooks": [
        { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/.claude/hooks/freshness_check.sh" }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Bash",
      "hooks": [
        { "type": "command", "command": "bash ${CLAUDE_PLUGIN_ROOT}/.claude/hooks/post_redline.sh" }
      ]
    }
  ]
}
