.claude/settings.local.json

# PDF chunker output (contracts/chunker.sh) - regenerable, never commit chunked contract text
contracts/chunks/

# NDA drafter output (drafting/draft_nda.sh) - regenerable, never commit drafted contract text
drafting/output/

# Redline report output (redlining/redline.sh) - regenerable, never commit generated reports
redlining/output/

# Extraction output (extraction/extract.sh) - regenerable, never commit extracted contract data
extraction/output/

# Transient per-call timing state for the post_redline.sh hook
.claude/hooks/.redline_timing/

# Single-use human-confirmation markers for the freshness_check.sh hook
.claude/hooks/.freshness_override/
