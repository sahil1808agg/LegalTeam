.claude/settings.local.json

# PDF chunker output (contracts/chunker.sh) - regenerable, never commit chunked contract text
contracts/chunks/

# NDA drafter output (drafting/draft_nda.sh) - regenerable, never commit drafted contract text
drafting/output/

# Redline report output (redlining/redline.sh) - regenerable, never commit generated reports
redlining/output/

# Extraction output (extraction/extract.sh) - regenerable, never commit extracted contract data
extraction/output/

# Deadline alert candidates (obligations/check_deadlines.sh) - regenerable, never commit
obligations/output/

# Transient per-call timing state for the post_redline.sh hook
.claude/hooks/.redline_timing/

# Single-use human-confirmation markers for the freshness_check.sh hook
.claude/hooks/.freshness_override/

# Tool-call access log written by .claude/hooks/audit_log.sh - local runtime
# record of every tool call in a session (including ad hoc debugging), not
# curated deliverable content; never commit
obligations/audit/

# Full pipeline report (run_pipeline.sh) - regenerable, assembled from
# extraction/redline/obligations output already excluded above; never commit
pipeline_report_*.md
